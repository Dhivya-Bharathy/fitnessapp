# ── SUPABASE (required, safe to bundle) ────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── NVIDIA MODELS (not secrets, just config) ──────────────────
EXPO_PUBLIC_NVIDIA_MODEL=meta/llama-3.1-70b-instruct
EXPO_PUBLIC_NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# OpenAI — Demic Story assessment plan (demo; use server proxy for production)
EXPO_PUBLIC_OPENAI_API_KEY=sk-your-openai-key
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# ── SENSITIVE API KEYS ──────────────────────────────────────────
# These are NO LONGER used directly in the app.
# API calls go through Supabase Edge Functions (ai-proxy, deepgram-proxy)
# which read keys from server-side secrets.
#
# To deploy Edge Functions and set secrets:
#   1. Install Supabase CLI: npm i -g supabase
#   2. Login: supabase login
#   3. Link: supabase link --project-ref your-project-ref
#   4. Set secrets:
#      supabase secrets set NVIDIA_API_KEY=nvapi-...
#      supabase secrets set NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#      supabase secrets set DEEPGRAM_API_KEY=your_deepgram_key
#   5. Deploy:
#      supabase functions deploy ai-proxy --no-verify-jwt
#      supabase functions deploy deepgram-proxy --no-verify-jwt
#
# Old keys (kept here as reference backup, NOT read by the app):
# EXPO_PUBLIC_NVIDIA_API_KEY=nvapi-...
# EXPO_PUBLIC_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# EXPO_PUBLIC_DEEPGRAM_KEY=your-deepgram-api-key-here
