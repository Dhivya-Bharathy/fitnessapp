# ── SUPABASE (required, safe to bundle) ────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── OpenAI (server-side only — never EXPO_PUBLIC_ for the API key) ──
OPENAI_API_KEY=sk-your-openai-key
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
EXPO_PUBLIC_OPENAI_VISION_MODEL=gpt-4o-mini

# Local / phone browser: point app at your PC proxy (npm run proxy:ai)
# EXPO_PUBLIC_ASSESSMENT_PROXY_URL=http://192.168.1.10:8787
# ASSESSMENT_PROXY_PORT=8787

# Netlify production: set OPENAI_API_KEY in Netlify env (not in git).
# App calls /.netlify/functions/openai-proxy and openai-transcribe automatically.
